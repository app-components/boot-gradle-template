# ### Bytecode and C extensions ###
# __pycache__/
# *.py[codz]
# *.so

# ### Packaging (anchored — each Python package in a monorepo gets its own) ###
# /dist/
# /build/
# *.egg-info/

# ### Virtual environments (uv, poetry, and pipenv default to .venv) ###
# .venv/
# venv/

# ### Test, coverage, type-check, and lint caches ###
# .pytest_cache/
# .tox/
# .nox/
# .hypothesis/
# .coverage
# .coverage.*
# htmlcov/
# coverage.xml
# *.lcov
# .mypy_cache/
# .dmypy.json
# dmypy.json
# .ruff_cache/

# ### Tool state ###
# .pdm-python
# .pdm-build/
# .pypirc

# ### Notebooks and docs ###
# .ipynb_checkpoints/
# docs/_build/

# # Lockfiles (uv.lock, poetry.lock, pdm.lock, Pipfile.lock) and
# # .python-version should be COMMITTED.

